# --- WHOOP Official API (v2) ---
# Register an app at https://developer-dashboard.whoop.com to get these.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8721/callback

# Scopes to request (space separated).
WHOOP_SCOPES=read:recovery read:cycles read:workout read:sleep read:profile read:body_measurement

# --- Local storage ---
# Unified SQLite database holding both API metrics and BLE samples.
WHOOP_DB_PATH=data/whoop.sqlite

# --- BLE (reverse-engineered path) ---
# macOS exposes a CoreBluetooth UUID; Linux/Android uses a MAC address.
WHOOP_BLE_ADDRESS=
# Optional: your strap serial, used to tag rows.
WHOOP_DEVICE_ID=
